# Client Environment Variables (Vite)
# ─────────────────────────────────────────────────────────
# All Vite env vars MUST start with VITE_ to be exposed to the browser.
# Set these in your frontend hosting platform (Vercel, Netlify, etc.)

# Firebase API key
VITE_FIREBASE_API_KEY=AIzaSy...

# Backend server URL — no trailing slash
VITE_SERVER_URL=https://your-api.onrender.com
